export component KeyboardHelpOverlay {
    in property <bool> is-open;
    callback close-clicked;
    callback controls-moved;

    width: 100%; height: 100%;

    Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.7);
        opacity: root.is-open ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        animate opacity { duration: 200ms; }

        // Block clicks from passing through
        TouchArea {
            pointer-event(evt) => { if evt.kind == PointerEventKind.move { root.controls-moved(); } }
        }

        if root.is-open : Rectangle {
            width: 460px;
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: rgba(30, 30, 40, 0.95);
            border-radius: 12px;
            border-width: 1px;
            border-color: rgba(255, 255, 255, 0.1);

            VerticalLayout {
                padding: 24px;
                spacing: 12px;

                Text {
                    text: "Keyboard & Mouse Shortcuts";
                    color: #fff;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Rectangle { height: 1px; background: rgba(255, 255, 255, 0.1); }

                HorizontalLayout {
                    spacing: 16px;
                    VerticalLayout {
                        spacing: 8px;
                        width: 160px;
                        Text { text: "Space / K"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "F / Double Click"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "P"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "S"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "Left / Right"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "Up / Down / Scroll"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "Z / X"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "C"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "0 - 9"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "M"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                        Text { text: "?"; color: #0cf; font-weight: 600; horizontal-alignment: right; }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: "Play / Pause"; color: #ccc; }
                        Text { text: "Fullscreen Toggle"; color: #ccc; }
                        Text { text: "Picture-in-Picture (PiP)"; color: #ccc; }
                        Text { text: "Cycle Video Scale Mode"; color: #ccc; }
                        Text { text: "Seek Backward / Forward (-5s / +5s)"; color: #ccc; }
                        Text { text: "Volume Control (±5%)"; color: #ccc; }
                        Text { text: "Audio Delay (-50ms / +50ms)"; color: #ccc; }
                        Text { text: "Reset Audio Delay (0ms)"; color: #ccc; }
                        Text { text: "Jump to 0% - 90% Position"; color: #ccc; }
                        Text { text: "Mute / Unmute"; color: #ccc; }
                        Text { text: "Toggle Help"; color: #ccc; }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                Rectangle {
                    height: 36px;
                    background: close-btn.has_hover ? rgba(255,255,255,0.2) : rgba(255,255,255,0.1);
                    border-radius: 6px;
                    animate background { duration: 150ms; }
                    Text {
                        text: "Close";
                        color: #fff;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close-btn := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-clicked(); }
                        pointer-event(evt) => { if evt.kind == PointerEventKind.move { root.controls-moved(); } }
                    }
                }
            }
        }
    }
}
